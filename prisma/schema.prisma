// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  end_user
  vendor
  admin
}

enum VerificationStatus {
  draft
  under_review
  approved
  rejected
  changes_requested
  suspended
}

enum ListingStatus {
  draft
  under_review
  approved
  rejected
  changes_requested
  suspended
}

enum AvailabilityStatus {
  available
  blocked
  held
  booked
}

enum PackageStatus {
  draft
  active
  checked_out
}

enum BookingStatus {
  requested
  confirmed
  in_progress
  completed
  cancelled
  disputed
}

enum PaymentMethod {
  jazzcash
  easypaisa
  card
  bank_transfer
}

enum PaymentStatus {
  pending
  verifying
  held_escrow
  released
  refunded
  failed
  disputed
}

enum PayoutStatus {
  pending
  paid
}

model User {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @map("user_id") @db.Uuid
  role           UserRole
  full_name      String    @map("full_name")
  email          String    @unique
  password_hash  String?   @map("password_hash")
  oauth_provider String?   @map("oauth_provider")
  city           String?
  // consent_flags  Json     @default("{}") @map("consent_flags")
  is_verified    Boolean   @default(false) @map("is_verified")
  otp            String?   @map("otp")
  otp_expires_at DateTime? @map("otp_expires_at") @db.Timestamptz
  created_at     DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updated_at     DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  refresh_token  String?   @map("refresh_token")

  vendors  Vendor[]
  packages Package[]
  bookings Booking[]
  reviews  Review[]
  wishlist Wishlist[]

  @@map("user")
}

model Vendor {
  id                       String             @id @default(dbgenerated("gen_random_uuid()")) @map("vendor_id") @db.Uuid
  owner_user_id            String             @map("owner_user_id") @db.Uuid
  legal_business_name      String             @map("legal_business_name")
  cnic_or_reg_number_enc   Bytes              @map("cnic_or_reg_number_enc")
  verification_status      VerificationStatus @default(draft) @map("verification_status")
  commission_rate_override Decimal?           @map("commission_rate_override") @db.Decimal(5, 2)
  payout_bank_details_enc  Bytes?             @map("payout_bank_details_enc")
  created_at               DateTime           @default(now()) @map("created_at") @db.Timestamptz

  owner_user            User                @relation(fields: [owner_user_id], references: [id])
  listings              VendorListing[]
  payout_ledger_entries PayoutLedgerEntry[]

  @@index([owner_user_id], name: "idx_vendor_owner")
  @@map("vendor")
}

model Category {
  id                        String  @id @default(dbgenerated("gen_random_uuid()")) @map("category_id") @db.Uuid
  name                      String
  slug                      String  @unique
  attribute_schema          Json    @map("attribute_schema")
  default_budget_weight_pct Decimal @map("default_budget_weight_pct") @db.Decimal(5, 2)

  listings           VendorListing[]
  package_line_items PackageLineItem[]

  @@map("category")
}

model VendorListing {
  id                      String        @id @default(dbgenerated("gen_random_uuid()")) @map("listing_id") @db.Uuid
  vendor_id               String        @map("vendor_id") @db.Uuid
  category_id             String        @map("category_id") @db.Uuid
  city                    String
  area                    String?
  title                   String
  description             String?
  status                  ListingStatus @default(draft)
  requires_reverification Boolean       @default(false) @map("requires_reverification")
  attributes              Json          @default("{}")
  avg_rating              Decimal       @default(0) @map("avg_rating") @db.Decimal(3, 2)
  review_count            Int           @default(0) @map("review_count")
  ai_eligibility_score    Int           @default(0) @map("ai_eligibility_score")
  created_at              DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updated_at              DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  vendor                  Vendor                 @relation(fields: [vendor_id], references: [id])
  category                Category               @relation(fields: [category_id], references: [id])
  pricing_tiers           PricingTier[]
  calendar_availabilities CalendarAvailability[]
  package_line_items      PackageLineItem[]
  bookings                Booking[]
  reviews                 Review[]
  wishlist                Wishlist[]

  @@index([city, category_id, status], name: "idx_listing_city_category_status")
  @@index([vendor_id], name: "idx_listing_vendor")
  @@index([attributes], name: "idx_listing_attributes_gin", type: Gin)
  @@map("vendor_listing")
}

model PricingTier {
  id               String  @id @default(dbgenerated("gen_random_uuid()")) @map("tier_id") @db.Uuid
  listing_id       String  @map("listing_id") @db.Uuid
  name             String
  min_capacity     Int?    @map("min_capacity")
  max_capacity     Int?    @map("max_capacity")
  base_price_paisa BigInt  @map("base_price_paisa")
  currency         String  @default("PKR")
  inclusions       Json    @default("[]")
  is_active        Boolean @default(true) @map("is_active")

  listing            VendorListing     @relation(fields: [listing_id], references: [id])
  package_line_items PackageLineItem[]
  bookings           Booking[]

  @@index([listing_id], name: "idx_tier_listing")
  @@map("pricing_tier")
}

model CalendarAvailability {
  id              String             @id @default(dbgenerated("gen_random_uuid()")) @map("availability_id") @db.Uuid
  listing_id      String             @map("listing_id") @db.Uuid
  date            DateTime           @db.Date
  status          AvailabilityStatus @default(available)
  hold_expires_at DateTime?          @map("hold_expires_at") @db.Timestamptz
  booking_id      String?            @map("booking_id") @db.Uuid

  listing VendorListing @relation(fields: [listing_id], references: [id])
  booking Booking?      @relation(fields: [booking_id], references: [id])

  @@unique([listing_id, date])
  @@index([date, status], name: "idx_availability_date_status")
  @@map("calendar_availability")
}

model Package {
  id                 String        @id @default(dbgenerated("gen_random_uuid()")) @map("package_id") @db.Uuid
  user_id            String        @map("user_id") @db.Uuid
  title              String?
  total_budget_paisa BigInt        @map("total_budget_paisa")
  wedding_date       DateTime?     @map("wedding_date") @db.Date
  guest_count        Int?          @map("guest_count")
  status             PackageStatus @default(draft)
  created_at         DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updated_at         DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  user       User              @relation(fields: [user_id], references: [id])
  line_items PackageLineItem[]
  bookings   Booking[]

  @@index([user_id], name: "idx_package_user")
  @@map("package")
}

model PackageLineItem {
  id                     String  @id @default(dbgenerated("gen_random_uuid()")) @map("line_item_id") @db.Uuid
  package_id             String  @map("package_id") @db.Uuid
  category_id            String  @map("category_id") @db.Uuid
  listing_id             String? @map("listing_id") @db.Uuid
  tier_id                String? @map("tier_id") @db.Uuid
  allocated_budget_paisa BigInt  @map("allocated_budget_paisa")
  actual_price_paisa     BigInt? @map("actual_price_paisa")
  is_locked              Boolean @default(false) @map("is_locked")
  rank_at_selection      Int?    @map("rank_at_selection")
  rationale_text         String? @map("rationale_text")

  package  Package        @relation(fields: [package_id], references: [id])
  category Category       @relation(fields: [category_id], references: [id])
  listing  VendorListing? @relation(fields: [listing_id], references: [id])
  tier     PricingTier?   @relation(fields: [tier_id], references: [id])

  @@index([package_id], name: "idx_line_item_package")
  @@map("package_line_item")
}

model Booking {
  id                       String        @id @default(dbgenerated("gen_random_uuid()")) @map("booking_id") @db.Uuid
  package_id               String?       @map("package_id") @db.Uuid
  user_id                  String        @map("user_id") @db.Uuid
  listing_id               String        @map("listing_id") @db.Uuid
  tier_id                  String?       @map("tier_id") @db.Uuid
  event_date               DateTime      @map("event_date") @db.Date
  guest_count              Int?          @map("guest_count")
  status                   BookingStatus @default(requested)
  agreed_total_price_paisa BigInt        @map("agreed_total_price_paisa")
  created_at               DateTime      @default(now()) @map("created_at") @db.Timestamptz

  package                 Package?               @relation(fields: [package_id], references: [id])
  user                    User                   @relation(fields: [user_id], references: [id])
  listing                 VendorListing          @relation(fields: [listing_id], references: [id])
  tier                    PricingTier?           @relation(fields: [tier_id], references: [id])
  payments                Payment[]
  payout_ledger_entries   PayoutLedgerEntry[]
  reviews                 Review[]
  calendar_availabilities CalendarAvailability[]

  @@index([user_id], name: "idx_booking_user")
  @@index([listing_id, event_date], name: "idx_booking_listing_date")
  @@map("booking")
}

model Payment {
  id              String        @id @default(dbgenerated("gen_random_uuid()")) @map("payment_id") @db.Uuid
  booking_id      String        @map("booking_id") @db.Uuid
  milestone_label String        @map("milestone_label")
  amount_paisa    BigInt        @map("amount_paisa")
  currency        String        @default("PKR")
  method          PaymentMethod
  gateway_txn_ref String?       @unique @map("gateway_txn_ref")
  status          PaymentStatus @default(pending)
  scheduled_date  DateTime      @map("scheduled_date") @db.Date
  captured_at     DateTime?     @map("captured_at") @db.Timestamptz
  released_at     DateTime?     @map("released_at") @db.Timestamptz

  booking Booking @relation(fields: [booking_id], references: [id])

  @@index([booking_id], name: "idx_payment_booking")
  @@index([status, scheduled_date], name: "idx_payment_status_scheduled")
  @@map("payment")
}

model PayoutLedgerEntry {
  id                      String       @id @default(dbgenerated("gen_random_uuid()")) @map("ledger_id") @db.Uuid
  vendor_id               String       @map("vendor_id") @db.Uuid
  booking_id              String       @map("booking_id") @db.Uuid
  gross_amount_paisa      BigInt       @map("gross_amount_paisa")
  commission_amount_paisa BigInt       @map("commission_amount_paisa")
  net_payout_paisa        BigInt       @map("net_payout_paisa")
  status                  PayoutStatus @default(pending)
  paid_at                 DateTime?    @map("paid_at") @db.Timestamptz

  vendor  Vendor  @relation(fields: [vendor_id], references: [id])
  booking Booking @relation(fields: [booking_id], references: [id])

  @@index([vendor_id], name: "idx_ledger_vendor")
  @@map("payout_ledger_entry")
}

model Review {
  id                  String   @id @default(dbgenerated("gen_random_uuid()")) @map("review_id") @db.Uuid
  booking_id          String?  @map("booking_id") @db.Uuid
  user_id             String   @map("user_id") @db.Uuid
  listing_id          String   @map("listing_id") @db.Uuid
  rating              Int
  text                String?
  is_verified_booking Boolean  @default(false) @map("is_verified_booking")
  created_at          DateTime @default(now()) @map("created_at") @db.Timestamptz

  booking Booking?      @relation(fields: [booking_id], references: [id])
  user    User          @relation(fields: [user_id], references: [id])
  listing VendorListing @relation(fields: [listing_id], references: [id])

  @@unique([booking_id, user_id])
  @@index([listing_id], name: "idx_review_listing")
  @@map("review")
}

model Wishlist {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @map("wishlist_id") @db.Uuid
  user_id    String   @map("user_id") @db.Uuid
  listing_id String   @map("listing_id") @db.Uuid
  created_at DateTime @default(now()) @map("created_at") @db.Timestamptz

  user    User          @relation(fields: [user_id], references: [id])
  listing VendorListing @relation(fields: [listing_id], references: [id])

  @@unique([user_id, listing_id])
  @@map("wishlist")
}
